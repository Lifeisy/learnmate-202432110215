# LearnMate 环境变量示例
# 说明：Spring Boot 不会自动读取本文件；请在 PowerShell 中使用 $env:NAME="value"，
# 或在 Linux/macOS 中使用 export NAME="value" 后再启动应用。

# 服务端口
SERVER_PORT=8080

# 默认 h2；连接 MySQL 时改为 mysql
SPRING_PROFILES_ACTIVE=h2

# JWT 密钥：生产环境必须替换为至少 32 字节的随机值
JWT_SECRET=learnmate-training-secret-key-change-me-2026-0123456789

# MySQL（仅 mysql profile 使用）
DB_URL=jdbc:mysql://localhost:3306/learnmate?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=learnmate
DB_PASSWORD=LearnMate@2026

# 大模型（不配置也能使用本地检索模式）
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
